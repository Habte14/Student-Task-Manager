# Copy this file to .env and fill in your real values.
# If your password contains special characters (@ : / ? # etc.), URL-encode them.
# e.g. a password of "Tinishu123@" becomes "Tinishu123%40" in the URL.
DATABASE_URL=postgresql://task_manager_app:your_password_here@localhost:5432/task_manager

CLIENT_ORIGIN=http://localhost:5173

PORT=3001
